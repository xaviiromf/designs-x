---
import { href, REPO } from '../lib/site';
interface Props { title?: string; description?: string; current?: 'designs' | 'principles' }
const { title, description = 'Original front-end sections with design notes, written for AI agents to read and reuse.', current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>{title ? `${title} | designs-x` : 'designs-x'}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={href('llms.txt')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top wrap">
      <a class="mark" href={href()} aria-label="designs-x, home">designs<span aria-hidden="true">-</span>x</a>
      <nav aria-label="Site">
        <a href={href()} aria-current={current === 'designs' ? 'page' : undefined}>Designs</a>
        <a href={href('principles/')} aria-current={current === 'principles' ? 'page' : undefined}>Principles</a>
        <a href={href('llms.txt')}>llms.txt</a>
        <a href={REPO}>GitHub</a>
      </nav>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="foot wrap">
      <p>Every design is original and MIT licensed. <a href={REPO}>Source and issues on GitHub</a>.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #e7eaee;
    --sheet: #f5f6f8;
    --ink: #17202c;
    --muted: #4c5665;
    --rule: #b9c1cc;
    --accent: #2639b8;
    --js-vanilla: #d9730d;
    --js-library: #d42020;
    --font: 'Schibsted Grotesk', system-ui, sans-serif;
    --code: ui-monospace, 'SF Mono', 'Cascadia Code', 'Source Code Pro', Menlo, monospace;
    --s-0: 0.875rem;
    --s-1: 1rem;
    --s-2: 1.1875rem;
    --s-3: 1.5rem;
    --s-4: 2.5rem;
    --sp-1: 0.5rem;
    --sp-2: 1rem;
    --sp-3: 1.5rem;
    --sp-4: 2.5rem;
    --sp-5: 4rem;
    --gutter: clamp(1rem, 4vw, 3rem);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #1a1f28;
      --sheet: #222833;
      --ink: #e3e7ed;
      --muted: #a2acba;
      --rule: #3b4453;
      --accent: #a8b6ff;
      --js-vanilla: #ff9f43;
      --js-library: #ff5f56;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 400 var(--s-1)/1.55 var(--font);
    font-feature-settings: 'ss01';
  }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 1px; }
  img, iframe { display: block; max-width: 100%; }
  h1, h2, h3 { font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; }
  code, pre { font-family: var(--code); font-size: 0.875em; }
  .wrap { width: 100%; max-width: 92rem; margin-inline: auto; padding-inline: var(--gutter); }
  .muted { color: var(--muted); }
  .skip { position: absolute; left: -999px; top: 0; background: var(--sheet); padding: var(--sp-1) var(--sp-2); }
  .skip:focus { left: var(--sp-2); z-index: 10; }
  /* JavaScript labels: orange underline = plain JS, red underline = GSAP/Lenis or other libraries. */
  .js { text-decoration: underline 2px; text-underline-offset: 0.25em; white-space: nowrap; }
  .js-vanilla { text-decoration-color: var(--js-vanilla); }
  .js-library { text-decoration-color: var(--js-library); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-1) var(--sp-3); padding-block: var(--sp-3); }
  .mark { font-weight: 700; font-size: var(--s-2); text-decoration: none; letter-spacing: -0.02em; }
  .mark span { color: var(--accent); padding-inline: 0.05em; }
  .top nav { display: flex; flex-wrap: wrap; gap: var(--sp-1) var(--sp-3); font-size: var(--s-0); }
  .top nav a { text-decoration: none; }
  .top nav a[aria-current='page'] { text-decoration: underline; }
  .foot { padding-block: var(--sp-5) var(--sp-4); font-size: var(--s-0); color: var(--muted); }

  /* Crop marks: the site's one recurring device. Every design is shown as a proof. */
  .proof { position: relative; background: var(--sheet); }
  .proof::before {
    --m: var(--muted);
    content: '';
    position: absolute;
    inset: -14px;
    pointer-events: none;
    background:
      linear-gradient(var(--m), var(--m)) left 0 top 14px / 9px 1px no-repeat,
      linear-gradient(var(--m), var(--m)) left 14px top 0 / 1px 9px no-repeat,
      linear-gradient(var(--m), var(--m)) right 0 top 14px / 9px 1px no-repeat,
      linear-gradient(var(--m), var(--m)) right 14px top 0 / 1px 9px no-repeat,
      linear-gradient(var(--m), var(--m)) left 0 bottom 13px / 9px 1px no-repeat,
      linear-gradient(var(--m), var(--m)) left 14px bottom 0 / 1px 9px no-repeat,
      linear-gradient(var(--m), var(--m)) right 0 bottom 13px / 9px 1px no-repeat,
      linear-gradient(var(--m), var(--m)) right 14px bottom 0 / 1px 9px no-repeat;
  }

  .prose { max-width: 68ch; }
  .prose h1 { font-size: var(--s-4); margin: 0 0 var(--sp-3); }
  .prose h2 { font-size: var(--s-3); margin: var(--sp-4) 0 var(--sp-2); }
  .prose h3 { font-size: var(--s-2); margin: var(--sp-3) 0 var(--sp-1); }
  .prose > :first-child { margin-top: 0; }
  .prose p, .prose li { max-width: 68ch; }
  .prose li + li { margin-top: 0.35em; }
  .prose code { background: var(--sheet); padding: 0.1em 0.3em; border-radius: 3px; }
  .prose table { border-collapse: collapse; width: 100%; font-size: var(--s-0); margin-block: var(--sp-2); display: block; overflow-x: auto; }
  .prose th, .prose td { text-align: left; vertical-align: top; padding: 0.5em 1em 0.5em 0; border-bottom: 1px solid var(--rule); }
  .prose th { font-weight: 600; }
</style>
