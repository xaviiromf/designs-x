---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';

const entry = await getEntry('principles', 'principles');
if (!entry) throw new Error('PRINCIPLES.md not found');
const { Content } = await render(entry);
---
<Base title="Principles" description="The taste behind designs-x: what a design is, the defaults it avoids, and its quality floor." current="principles">
  <article class="prose page">
    <Content />
    <p class="muted raw">Raw file for agents: <a href={href('PRINCIPLES.md')}>PRINCIPLES.md</a></p>
  </article>
</Base>
<style>
  .page { padding-block: var(--sp-4); }
  .raw { margin-top: var(--sp-5); font-size: var(--s-0); }
</style>
